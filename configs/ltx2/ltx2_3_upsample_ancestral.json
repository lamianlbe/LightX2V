{
    "_comment": "LTX-2.3 distilled two-stage, ComfyUI-style ancestral sampling: euler_ancestral to generate, euler_ancestral_cfg_pp to refine. cfg_pp cannot run on stage 1 because that schedule starts at sigma=1.0 (alpha = 1 - sigma = 0 is singular); stage 2 starts at 0.909375 so it is fine. cfg_pp always pays one extra unconditional forward per step, matching ComfyUI's disable_cfg1_optimization, so set a real negative_prompt for it to be meaningful.",
    "infer_steps": 8,
    "target_video_length": 241,
    "target_height": 1024,
    "target_width": 1536,
    "attn_type": "flash_attn4",
    "sample_guide_scale": 1,
    "sample_shift": [2.05, 0.95],
    "enable_cfg": false,
    "cpu_offload": true,
    "offload_granularity": "block",
    "vae_cpu_offload": false,
    "num_channels_latents": 128,
    "fps": 24,
    "audio_fps": 24000,
    "audio_mel_bins": 16,
    "double_precision_rope": true,
    "dit_original_ckpt": "Lightricks/LTX-2.3/ltx-2.3-22b-distilled-1.1.safetensors",
    "skip_fp8_block_index": [0, 43, 44, 45, 46, 47],
    "distilled_sigma_values": [1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0],
    "caption_proj_before_connector": true,
    "cross_attention_adaln": true,
    "apply_gated_attention": true,
    "use_upsampler": true,
    "upsampler_original_ckpt": "Lightricks/LTX-2.3/ltx-2.3-spatial-upscaler-x2-1.1.safetensors",
    "distilled_sigma_values_upsample": [0.909375, 0.725, 0.421875, 0.0],
    "sampler_stage1": "euler_ancestral",
    "sampler_stage2": "euler_ancestral_cfg_pp",
    "sampler_eta": 1.0,
    "sampler_s_noise": 1.0,
    "ancestral_repin_mode": "noised"
}
